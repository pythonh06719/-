{
  "name": "@qsh/api",
  "version": "0.1.0",
  "private": true,
  "description": "轻生活后端 API（NestJS 12）：鉴权 + 引导/重算 + 食物库 + 饮食记录 + 套餐 + 体重 + 看板",
  "scripts": {
    "build": "nest build && node scripts/rewrite-aliases.cjs",
    "prestart": "npm run build",
    "start": "node dist/apps/api/src/main.js",
    "start:dev": "npm run build && node dist/apps/api/src/main.js",
    "start:prod": "node dist/apps/api/src/main.js",
    "pretest": "npm run build && npm run prisma:push && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:validate:pg": "prisma validate --schema prisma/schema.pg.prisma",
    "check:schema": "node scripts/check-schema-parity.mjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.22.0",
    "@qsh/core": "*",
    "@qsh/shared-types": "*",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "express": "5.2.1",
    "helmet": "^7.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "@types/express": "^5.0.6"
  }
}
