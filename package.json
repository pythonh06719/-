{
  "name": "qingshenghuo",
  "version": "0.1.0",
  "private": true,
  "description": "轻生活 —— 移动端优先的生活化减肥 Web/PWA（npm workspaces 单体仓库）",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma",
    "test": "npm run test:core && npm run test:api && npm run test:web",
    "test:core": "npm run test -w @qsh/core",
    "test:web": "npm run test -w @qsh/web",
    "test:api": "npm run test -w @qsh/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @qsh/web",
    "build": "npm run build -w @qsh/web",
    "preview": "npm run preview -w @qsh/web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "pinyin-pro": "^3.29.4",
    "typescript": "^5.5.4"
  }
}
