{
  "name": "@qsh/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "轻生活前后端共享契约类型（纯类型包，零运行时依赖）：实体 / API DTO / 数据主权导出契约",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
