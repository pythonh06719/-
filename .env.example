# =============================================================================
# 「轻生活」环境变量示例（模板）—— 复制为 .env 后按需填写
#   cp .env.example .env
# .env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库。
#
# ⚠️ 唯一事实源：**仓库根 .env**（apps/api/src/config/app-config.ts 的 loadEnv 先读它）。
#    不要在 `apps/api/.env` 里重复声明 JWT_* / AI_* 等应用配置（上线前全检 F-005）：
#    PrismaClient 构造时会先加载 apps/api/.env，而 dotenv 不覆盖已存在的变量 →
#    那里的值会**遮蔽本文件**。实测把 JWT_SECRET 写在 apps/api/.env 时，
#    即使根 .env 配了强随机密钥，应用仍用前者签发令牌。
#    `apps/api/.env` 只应保留 DATABASE_URL（供在 apps/api 目录下直接跑 prisma CLI）。
# =============================================================================

# --- 数据库 ---
# SQLite（MVP 默认）：相对 schema 目录（apps/api/prisma/）解析 → apps/api/prisma/dev.db
DATABASE_URL="file:./dev.db"
# PostgreSQL 16（生产，二期）：供 apps/api/prisma/schema.pg.prisma 使用
#
# ⚠️ 默认留空 —— 默认路径（SQLite）不需要它。
#    云端发布沙箱只支持 SQLite，且其前置检查是**按字符串匹配连接串、不解析注释**：
#    只要 env 文件里出现指向本地端口的 PG 连接串，就会判定「需要外部数据库服务」而拒绝整个项目。
#    因此这里连示例连接串也不保留。需要生产 Postgres（Render / Neon / Supabase 等）时，
#    把连接串填在这行即可，写法与示例见 docs/deploy-aliyun.md。
DATABASE_URL_PG=

# --- 鉴权（JWT，ARCHITECTURE §1.7）---
# 访问令牌（ACCESS）签名密钥：生产必须替换为高强度随机值（>=32 字符）
JWT_SECRET=""
# 访问令牌有效期（如 2h / 30m）
JWT_EXPIRES_IN="2h"
# ⚠️ 刷新令牌（REFRESH）**尚未实现**（上线前全检 F-004）：后端只签发 accessToken，
#    也没有 HttpOnly Cookie / 吊销机制。曾有的 JWT_REFRESH_EXPIRES_IN 是**死配置**
#    （代码从不读取），已移除；实现 refresh 轮换时再加回并同步 app-config。

# --- AI（三期，ARCHITECTURE §1.8）---
# 总开关：设为 false 时**强制走规则兜底**（用于成本熔断 / 故障降级 / 测试），默认 true。
# 注意：应用把「空字符串」视为未配置（避免 shell / IDE 注入的空值遮蔽本文件）。
AI_ENABLED="true"
# LLM API Key：**仅存在于服务端环境变量**，绝不进入前端产物与网络请求（NFR-6 / TC-45）。
# 未配置时 /ai 与 AI 识别入口显示「暂不可用」，其余功能不受影响（TC-24）；
# daily-summary / today-plan / free-ask 会用服务端规则模板基于真实记录生成兜底内容。
# 示例（DeepSeek，OpenAI 兼容）：AI_API_KEY="sk-..."，AI_BASE_URL="https://api.deepseek.com/v1"，AI_MODEL="deepseek-chat"
AI_API_KEY=""
# OpenAI 兼容接口地址（chat/completions 格式），留空用默认值
AI_BASE_URL=""
# 模型名，留空用默认值
AI_MODEL=""

# --- 验证码出口开关（开发 / 未接 SMTP 的演示部署）---
# true = 验证码打印到服务端日志**并随 send-code 响应回显**（前端登录卡自动预填）。
# ⚠️ 权衡（上线前全检 F-011）：回显等价于「知道任意邮箱即可登录该账号」；
#    但在未接 SMTP 的部署里它是**唯一**登录通道（见 docs/deploy-aliyun.md「取登录验证码」）。
#    生产默认 false；接入真实发送渠道后必须保持 false。
AUTH_LOG_CODE="false"
