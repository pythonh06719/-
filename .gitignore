# dependencies
node_modules/
.pnp
.pnp.js

# build outputs
dist/
build/
# 临时构建目录：用于绕开本机 vite build 的 safe-delete 守卫（先 --outDir dist_tmp 再拷回 dist）。
# 加这条是因为它真的被误提交过两次：命令被并发重试时，第二次的 `git add -A` 抓到了第一次
# 还在构建中的 dist_tmp（历史里因此留下 ~1.5MB 构建产物，共两处）。
dist_tmp/
# `nest build` 同理：本机 safe-delete 会拦 `rm -rf dist`（报 SAFE_DELETE_BULK_CONFIRM_REQUIRED），
# 绕过办法是先把 dist 移出去再 build，于是仓库根会留下 `.dist-bak-*` / `.dist-bad-*` 之类的备份
# （2026-09-29 有两位工程师各留了一个，共 3.6MB，污染 git status）。
# 这类目录不入库；**移出时请用系统临时目录，不要放仓库内**。
.dist-*/
coverage/
# 带后缀的覆盖率输出（如 `packages/core/coverage-r11x/`）：同样是 istanbul 生成物，不入库
coverage-*/
# ⚠️ 已证伪的旧经验（2026-09-29 修正）：曾以为本机 `TEMP` 必须指向仓库内才能绕开 EPERM 丢测试文件。
# 实测**相反** —— `TEMP` 设在仓库内会让测试临时目录向上回溯，命中真实的
# `infra/db/seed/food_embeddings.json`，诱导 `rag.vector-path.test.ts` **假失败**。
# 正确做法：用**系统默认 TEMP** + `--no-file-parallelism`。
# 此条目保留仅为兼容旧环境，不要再用它。
.tmp-vitest/
*.tsbuildinfo
# Taro/SWC 编译缓存（`taro build` 时自动生成，纯缓存产物，勿提交）
.swc/

# env / secrets
.env
.env.local
.env.*.local

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# database (local sqlite)
*.sqlite
*.sqlite3
*.db

# 本地备份（含密钥或数据快照，禁止提交）
*.bak
.env.bak*

# vitest 临时缓存（vite/vitest 配置加载产物，勿提交）
*.timestamp-*.mjs

# AI 评测生成物（可随时重跑生成，不入库；结论与数字见 docs/AGENT.md）
apps/api/eval/eval-report.json

# 一次性验证/取证脚本与产物（QA/本地探针，不应入库）
qa-probe-*
qa-verify/
tmp-qa/
_qsh-*

# QA/PM 历史轮次的取证截图（playwright 截屏，可随时重生成，不入库）
_r2-shot-*.png
_v7-*.png
qa-r26-evidence-*.png

# CFCD（中国食物成分表）个人自用数据 —— 不得随仓库分发（上线前全检 F-001，见 DATA-LICENSE.md）。
# 采集/转换脚本与中间产物仅保留在本机磁盘；merge-seeds 默认不并入，
# 仅本地自建库可显式 `npx tsx infra/db/seed/merge-seeds.ts --with-cfcd`（产物不得提交/部署）。
infra/db/seed/food_items.cfcd.json
infra/db/seed/food_items.cfcd.raw.json
infra/db/seed/fetch-cfcd.mjs
infra/db/seed/import-cfcd.ts
