# dependencies
node_modules/
.pnp
.pnp.js

# build outputs
dist/
build/
# 临时构建目录：用于绕开本机 vite build 的 safe-delete 守卫（先 --outDir dist_tmp 再拷回 dist）。
# 加这条是因为它真的被误提交过两次：命令被并发重试时，第二次的 `git add -A` 抓到了第一次
# 还在构建中的 dist_tmp（历史里因此留下 ~1.5MB 构建产物，共两处）。
dist_tmp/
coverage/
*.tsbuildinfo

# env / secrets
.env
.env.local
.env.*.local

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# database (local sqlite)
*.sqlite
*.sqlite3
*.db

# 本地备份（含密钥或数据快照，禁止提交）
*.bak
.env.bak*

# vitest 临时缓存（vite/vitest 配置加载产物，勿提交）
*.timestamp-*.mjs

# AI 评测生成物（可随时重跑生成，不入库；结论与数字见 docs/AGENT.md）
apps/api/eval/eval-report.json

# 一次性验证/取证脚本与产物（QA/本地探针，不应入库）
qa-probe-*
qa-verify/
tmp-qa/
_qsh-*
